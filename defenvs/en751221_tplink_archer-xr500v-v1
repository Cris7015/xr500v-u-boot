loadaddr=0x89400000
ipaddr=192.168.1.1
serverip=192.168.1.10
bootled=green:power

bootconf=config-1
bootfile=openwrt-airoha-en751221-tplink_archer-xr500v-v1-initramfs-kernel.bin
bootloaderfile=openwrt-airoha-en751221-tplink_archer-xr500v-v1-uboot-bootloader.bin

boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr#$bootconf
ubi_read_openwrt=ubi read $loadaddr fit && iminfo $loadaddr

set_ethaddr=ubi read 0x89f00000 misc 0x480000 && bin2mac ethaddr 0x89f0f100 6

boot_openwrt=led $bootled blink 255; run set_ethaddr; if run ubi_read_openwrt; then bootm $loadaddr#$bootconf; else echo Install openwrt; run boot_tftp; fi; led $bootled on
boot_ubi=ubi part ubi && run boot_openwrt

upgrade_uboot=\
  mw.b 0x89400000 0xff 0x100000 && tftpboot 0x89400000 ${bootloaderfile} && \
  itest.l *0x8940000c == 0x36353738 && \
  mtd erase u-boot && mtd write u-boot 0x89400000

# U-Boot's SPI-NAND driver cannot read the OEM partitions (the OEM kernel
# maps them through its own BMT), so the factory data comes from dumps taken
# under the OEM-aware Linux driver, fetched over TFTP and checked before
# anything is erased:
#   misc (4.5 MiB): MAC at 0xf100, EN7570 calibration magic 0x07050700 at
#   0x20094, MT7662 EEPROM (0x7662) at 0xe0000; OEM bootloader: "6578" at 0xc.
miscfile=xr500v-misc.bin
oembootfile=xr500v-bootloader.bin
load_oem_backups=\
  tftpboot 0x89500000 ${miscfile} && itest ${filesize} == 480000 && \
  itest.b *0x8950f100 != 0xff && itest.l *0x89520094 == 0x07050700 && \
  itest.w *0x895e0000 == 0x6276 && \
  tftpboot 0x89a00000 ${oembootfile} && itest ${filesize} == 40000 && \
  itest.l *0x89a0000c == 0x36353738

format_ubi_part=\
  if run load_oem_backups; then \
    mtd erase ubi && \
    ubi part ubi && \
    ubi create ubootenv 0x1f000 static && \
    ubi create ubootenv2 0x1f000 static && \
    ubi create misc 0x480000 static && ubi write 0x89500000 misc 0x480000 && \
    ubi create tcboot_oem 0x40000 static && ubi write 0x89a00000 tcboot_oem 0x40000 && \
    run upgrade_uboot; \
  else \
    echo "OEM backups missing or invalid: nothing erased"; \
  fi

bootcmd=run boot_ubi
bootdelay=3
bootmenu_confirm_return=askenv - Press ENTER to return to menu ; bootmenu 20
bootmenu_default=0
bootmenu_delay=3
bootmenu_title=      34m( ( ( mOpenWrt34m ) ) )
bootmenu_0=Run default boot command.=run boot_openwrt
bootmenu_1=Boot system via TFTP.=run boot_tftp ; run bootmenu_confirm_return
bootmenu_2=Format UBI partition (OEM misc and bootloader from TFTP backups).=run format_ubi_part
bootmenu_4=Upgrade u-boot.=run upgrade_uboot
bootmenu_5=Reboot.=reset
