/*
 * EcoNet EN7528 reference board (DASAN H660GM-A).
 *
 * This board reuses the EN7528 SoC support - econet,en7528.dtsi and the
 * mach-en75xx port - originally written by
 * Matheus Sampaio Queiroga <srherobrine20@gmail.com> in the en7523_u-boot
 * tree. U-Boot proper is entered after an external DRAM/early-boot stage;
 * that stage and its bootext/flash images are not built in this tree.
 */
/dts-v1/;

#include "econet,en7528.dtsi"

/ {
	model = "EcoNet EN7528 reference board (DASAN H660GM-A)";
	compatible = "econet,en7528-reference", "econet,en7528";

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&uart0 {
	status = "okay";
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <25000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/*
			 * The external replacement bootloader currently reserves
			 * 1 MiB. This does not match the vendor 256 KiB layout;
			 * preserve the board-specific partitioning when flashing.
			 */
			partition@0 {
				label = "bootloader";
				reg = <0x00000000 0x00100000>;
				read-only;
			};
		};
	};
};

&eth {
	status = "okay";
};

&gdm1 {
	status = "okay";
};

&switch {
	status = "okay";
};
