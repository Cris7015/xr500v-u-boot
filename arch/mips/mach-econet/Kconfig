menu "Airoha MIPS platforms"
	depends on ARCH_ECONET

choice
	prompt "Airoha MIPS SoC"

config TARGET_EN751221
	bool "Airoha EN751221 SoC"
	select SUPPORT_BIG_ENDIAN
	select SYSCON
	select MIPS_TUNE_34KC
	select PINCTRL_AIROHA_EN751221
	select ECONET_FLASH_BOOT
	select SPL_LOADER_SUPPORT if SPL

config TARGET_EN751627
	bool "Airoha EN751627 SoC"
	select SUPPORT_BIG_ENDIAN
	select SYSCON
	select MIPS_TUNE_1004KC
	select MIPS_SKIP_CP0_COUNT_CLEAR
	select SPL_LOADER_SUPPORT if SPL
	help
	  EN7516/EN7527 shares most peripheral support with EN7528 but boots
	  big-endian and uses its own DDR-training payload and TCBoot metadata.

config TARGET_EN7528
	bool "Airoha EN7528 SoC"
	select SUPPORT_LITTLE_ENDIAN
	select SYSCON
	select MIPS_TUNE_1004KC
	select MIPS_SKIP_CP0_COUNT_CLEAR
	select PINCTRL_AIROHA_EN7528
	select ECONET_FLASH_BOOT
	select SPL_LOADER_SUPPORT if SPL

config TARGET_EN7580
	bool "Airoha EN7580 SoC"
	select SUPPORT_LITTLE_ENDIAN
	select SYSCON
	select MIPS_TUNE_1004KC
	select MIPS_SKIP_CP0_COUNT_CLEAR
	select BINMAN
	select SPL_LOADER_SUPPORT if SPL
	help
	  Select support for the little-endian MIPS32r2 EN7580 family.
	  Initial support targets direct TPL/SPL bring-up on the XGZ030.

endchoice

config ECONET_BOOTROM_CHAINLOADER
	bool "Build the BootROM XMODEM chainloader"
	depends on TARGET_EN751221
	default y
	help
	  Build en751221-chainloader.bin, a ~10 KiB standalone loader for the
	  EN751221 internal BootROM recovery path.

	  The BootROM downloads it to 0x80009000 over XMODEM and jumps there;
	  it then pulls an unmodified u-boot.bin over XMODEM into
	  CONFIG_TEXT_BASE and jumps to it. Nothing in U-Boot proper changes.

	  See arch/mips/mach-econet/chainloader/README.rst.

config ECONET_BOOTROM_CHAINLOADER_DDR
	bool "Run the V1.2.2 DDR stage from the chainloader"
	depends on ECONET_BOOTROM_CHAINLOADER
	default y
	help
	  BootROM recovery only runs the mask ROM's own DRAM init. It never
	  runs the V1.2.2 DDR stage that boot2 runs before U-Boot on the
	  flash path, so the PLLs stay at the BootROM's setting, DRAMC keeps
	  the BootROM's parameters, REG_SAVE_INFO carries no clock field and
	  QDMA does not write DONE back into TX descriptors.

	  With this option the chainloader embeds en751221_ddr.bin and a copy
	  of itself linked for FE SRAM, runs the DDR stage from there the way
	  boot2 does, and only then receives u-boot.bin. The image grows to
	  about 24 KiB.

config ECONET_FLASH_BOOT
	bool "Build the unsigned 128 KiB flash entry and raw U-Boot loader"
	depends on !SPL && !TPL
	default y
	help
	  Build tcboot.bin from SDK reset/move_data/boot2, DDR calibration and
	  a small uncompressed loader. U-Boot proper starts at flash offset
	  0x20000; the complete image occupies 1 MiB.

config SYS_VENDOR
	default "econet"

config SYS_SOC
	default "en751221" if TARGET_EN751221
	default "en7528" if TARGET_EN7528 || TARGET_EN751627
	default "en7580" if TARGET_EN7580

config SYS_BOARD
	default "en7512" if TARGET_EN751221
	default "en7528" if TARGET_EN7528 || TARGET_EN751627
	default "en7580" if TARGET_EN7580

config SYS_CONFIG_NAME
	default "en7512" if TARGET_EN751221
	default "en7528" if TARGET_EN7528 || TARGET_EN751627
	default "en7580" if TARGET_EN7580

config SYS_MALLOC_F_LEN
	default 0x2000

config SYS_DCACHE_SIZE
	default 32768

config SYS_DCACHE_LINE_SIZE
	default 32

config SYS_ICACHE_SIZE
	default 32768

config SYS_ICACHE_LINE_SIZE
	default 32

config TEXT_BASE
	default 0x81000000

config SPL_TEXT_BASE
	default 0x80010000

config SPL_SIZE_LIMIT
	default 0x30000

config TPL_TEXT_BASE
	default 0xbfc00000

config TPL_MAX_SIZE
	default 0x8000


config BUILD_TARGET
	default "u-boot.img"

endmenu
